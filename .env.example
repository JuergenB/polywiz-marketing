# PolyWiz Marketing Site
NEXT_PUBLIC_SITE_URL=https://polywiz.polymash.com

# Resend — transactional email (early access form notifications)
RESEND_API_KEY=re_your_api_key_here

# Early-access intake — persist applications via the PolyWiz app (#399).
#
# This site holds NO Airtable credential by design. It POSTs to the app's
# secret-gated /api/webhooks/beta-intake, which owns the Airtable write.
# BETA_INTAKE_SECRET must match the value set in the polywiz-app project.
# Rotate with: openssl rand -hex 32  (then update BOTH projects).
POLYWIZ_APP_URL=https://app.polywiz.polymash.com
BETA_INTAKE_SECRET=
